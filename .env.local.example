# Supabase (from your Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL= #fill it ur project url
NEXT_PUBLIC_SUPABASE_ANON_KEY= #fill it ur publishable key here
# Service role key — server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY= # fill ur secret key

# Anthropic (console.anthropic.com) — server-only
ANTHROPIC_API_KEY= #fill ur Claude API key

# Google Maps — client-side. Needs THREE APIs enabled on the same Google
# Cloud project: "Maps JavaScript API", "Places API" (classic), AND
# "Places API (New)" (used for photo fetching and recommendation search —
# a separate enablement/billing gate from classic Places API, easy to miss).
# MUST have HTTP referrer restrictions set in Google Cloud Console before
# this ships anywhere public — see CLAUDE.md.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# hCaptcha site key (public, client-side) — currently UNUSED, hCaptcha is
# paused (see CLAUDE.md's "CAPTCHA — currently paused"). Keep it set anyway
# so re-enabling later is just flipping HCAPTCHA_ENABLED back to true in
# components/groups/JoinAsGuest.tsx plus the matching Supabase Dashboard ->
# Authentication -> Settings -> Bot and Abuse Protection toggle.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=